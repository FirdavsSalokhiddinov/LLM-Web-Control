{
  "manifest_version": 3,
  "name": "Claude Browser Control",
  "version": "0.1.0",
  "description": "Lets a local Claude Code session control this browser via a local bridge server on 127.0.0.1.",
  "permissions": ["tabs", "scripting", "debugger", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Browser Control"
  }
}
