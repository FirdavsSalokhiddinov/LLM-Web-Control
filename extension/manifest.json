{
  "manifest_version": 3,
  "name": "LLM-Web-Control",
  "version": "0.1.0",
  "description": "Lets local LLMs crawl, scrape, and automate Chrome via a local bridge. Your data stays with you.",
  "permissions": ["tabs", "scripting", "debugger", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LLM-Web-Control"
  }
}
